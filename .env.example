ZHIHENG_ENVIRONMENT=development
ZHIHENG_DATABASE_URL=sqlite:///./var/zhiheng.db
ZHIHENG_SECRET_KEY=change-me-before-use
ZHIHENG_BOOTSTRAP_TOKEN=replace-with-base64url-32-byte-token
ZHIHENG_ERASE_JOURNAL_PATH=./var/erase-journal.jsonl
ZHIHENG_KNOWLEDGE_OBJECT_STORE_PATH=./var/knowledge-object-store
# Backup commands require explicit paths and an initialized restic repository.
# Supply RESTIC_PASSWORD or RESTIC_PASSWORD_FILE privately; never commit it.
# ZHIHENG_DATABASE_PATH=./var/zhiheng.db
# RESTIC_REPOSITORY=/path/to/private/restic-repository
ZHIHENG_EXTERNAL_MODELS_ENABLED=false
ZHIHENG_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
# Optional answer model binding. Configure both values together after adding an
# enabled provider row; leaving both unset keeps the extractive answer model.
# ZHIHENG_ANSWER_PROVIDER_ID=provider-local
# ZHIHENG_ANSWER_MODEL_ID=qwen2.5:7b
# External providers (keys stay in environment; never put real values in this file)
# ZHIHENG_PRIVATE_DEEPSEEK_API_KEY=replace-me
# ZHIHENG_PRIVATE_OPENAI_API_KEY=replace-me
# ZHIHENG_PRIVATE_CODEX2API_API_KEY=replace-me
# Optional model overrides used by scripts/configure_model_providers.py
# ZHIHENG_DEEPSEEK_MODEL=deepseek-chat
# ZHIHENG_OPENAI_MODEL=gpt-4.1-mini
# ZHIHENG_CODEX2API_MODEL=gpt-6-astra
# PDF parsing is a deployment capability and must be declared: mineru, deepdoc or none.
# The worker refuses to start when it is undeclared or incomplete (ADR 0005).
# Run `uv run zhiheng-worker --check` to verify the declaration and the parser service.
ZHIHENG_PDF_PARSER_BACKEND=none
# ZHIHENG_PDF_PARSER_BACKEND=mineru
# ZHIHENG_PDF_MINERU_URL=http://127.0.0.1:9392
# ZHIHENG_PDF_MINERU_TOKEN_FILE=./var/mineru-gateway.token
ZHIHENG_LOG_LEVEL=INFO
ZHIHENG_SITE_ADDRESS=http://localhost
